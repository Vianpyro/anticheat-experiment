{
    // The image provides rustup and a build environment. It does not define the
    // toolchain: rust-toolchain.toml does, so that a build in the container, on
    // the host and in CI are the same build.
    "name": "moba",
    "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "anthropic.claude-code"
            ]
        }
    },
    "postCreateCommand": "rustup show active-toolchain",
    "remoteUser": "vscode"
}
